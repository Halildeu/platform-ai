# Host-local live-STT data file. Production path:
# C:\ProgramData\Acik\platform-ai\live-stt.env
#
# The production file must disable ACL inheritance and grant access only to
# SYSTEM and Administrators. It is parsed as data and is never dot-sourced.
# Secrets must be DPAPI LocalMachine blobs; plaintext STT_REDIS_URL is rejected.

STT_CHUNK_CONSUMER_ENABLED=false
# STT_REDIS_URL_DPAPI=<base64 DPAPI LocalMachine blob>
# STT_REQUEST_TIMEOUT=180
